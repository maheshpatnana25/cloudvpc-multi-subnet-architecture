  "security_groups": [
    {
      "id": "sg-01_alb",
      "name": "alb-security-group",
      "description": "Permit inbound HTTPS/HTTP from public internet and egress to App SG",
      "ingress_rules": [
        {"protocol": "TCP", "port": 443, "source": "0.0.0.0/0", "description": "Public HTTPS traffic"},
        {"protocol": "TCP", "port": 80, "source": "0.0.0.0/0", "description": "Public HTTP redirection"}
      ],
      "egress_rules": [
        {"protocol": "TCP", "port": 8080, "destination": "sg-02_app", "description": "Forward traffic to App Nodes"}
      ]
    },
    {
      "id": "sg-01_bastion",
      "name": "bastion-security-group",
      "description": "Permit SSH only from approved corporate IP CIDR",
      "ingress_rules": [
        {"protocol": "TCP", "port": 22, "source": "198.51.100.0/24", "description": "Corporate VPN SSH Access"}
      ],
      "egress_rules": [
        {"protocol": "TCP", "port": 22, "destination": "sg-02_app", "description": "SSH jump to App servers"}
      ]
    },
    {
      "id": "sg-02_app",
      "name": "app-tier-security-group",
      "description": "Permit ingress from ALB on 8080 and SSH from Bastion",
      "ingress_rules": [
        {"protocol": "TCP", "port": 8080, "source": "sg-01_alb", "description": "HTTP traffic from ALB"},
        {"protocol": "TCP", "port": 22, "source": "sg-01_bastion", "description": "SSH from Bastion"}
      ],
      "egress_rules": [
        {"protocol": "TCP", "port": 5432, "destination": "sg-03_db", "description": "PostgreSQL traffic to DB tier"},
        {"protocol": "TCP", "port": 443, "destination": "0.0.0.0/0", "description": "Outbound HTTPS via NAT for package updates"}
      ]
    },
    {
      "id": "sg-03_db",
      "name": "database-tier-security-group",
      "description": "Strictly permit database queries ONLY from Application Tier SG",
      "ingress_rules": [
        {"protocol": "TCP", "port": 5432, "source": "sg-02_app", "description": "PostgreSQL queries from App Nodes ONLY"}
      ],
      "egress_rules": []
    }
  ],
